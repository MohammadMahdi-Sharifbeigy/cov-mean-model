    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "    def forward(self, x):\n",
    "        return 2.0 * torch.sqrt(x + 3.0 / 8.0)\n",
    "\n",
    "    def inv(self, x):\n",
    "        return (x / 2.0) ** 2 - 3.0 / 8.0\n",
